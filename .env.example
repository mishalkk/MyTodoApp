# PostgreSQL administrator
POSTGRES_USER=replace_with_admin_username
POSTGRES_PASSWORD=replace_with_admin_password
POSTGRES_DB=replace_with_database_name

# Backend database connection
DB_HOST=postgres
DB_PORT=5432
APP_DB_NAME=replace_with_database_name
APP_DB_USER=replace_with_application_username
APP_DB_PASSWORD=replace_with_application_password

# n8n reverse proxy settings
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/
